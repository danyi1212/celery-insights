{
    "name": "celery-insights",
    "private": true,
    "version": "0.2.0",
    "packageManager": "bun@1.4.2",
    "type": "module",
    "scripts": {
        "dev": "bunx --bun vite dev --port 3000",
        "build": "bunx --bun vite build",
        "start": "bun --no-env-file run bun-entry.ts",
        "typecheck": "tsc --noEmit",
        "check:frontend": "bun run typecheck && bun run lint && bun run format && bun run test",
        "format": "oxfmt --check src runtime bun-entry.ts e2e tooling vite.config.ts vitest.config.ts vitest.setup.ts",
        "format-fix": "oxfmt src runtime bun-entry.ts e2e tooling vite.config.ts vitest.config.ts vitest.setup.ts",
        "lint": "oxlint --deny-warnings src runtime bun-entry.ts e2e tooling vite.config.ts vitest.config.ts vitest.setup.ts",
        "lint-fix": "oxlint --deny-warnings --fix src runtime bun-entry.ts e2e tooling vite.config.ts vitest.config.ts vitest.setup.ts",
        "e2e": "playwright test --config e2e/playwright.config.ts",
        "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
        "test": "vitest run",
        "test:observation": "bun run tooling/verify-observation.ts",
        "test:watch": "vitest",
        "dev:surreal": "surreal start --bind 127.0.0.1:8557 --username root --password root memory",
        "dev:server": "uv run --no-sync bun --no-env-file run bun-entry.ts",
        "dev:bridge": "uv run --no-sync bun --no-env-file run runtime/config-cli.ts python",
        "dev:all": "concurrently \"bun run dev:server\" \"bun run dev\"",
        "config": "bun --no-env-file run runtime/config-cli.ts"
    },
    "dependencies": {
        "@danyi1212/time-range-picker": "^0.1.1",
        "@floating-ui/react": "^0.27.20",
        "@mdx-js/react": "^3.1.1",
        "@modelcontextprotocol/sdk": "^1.31.0",
        "@surrealdb/wasm": "^3.0.3",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-hotkeys": "^0.12.1",
        "@tanstack/react-query": "^5.104.0",
        "@tanstack/react-router": "^1.170.41",
        "@tanstack/react-table": "^9.2.4",
        "@uiw/react-json-view": "^2.0.0-alpha.43",
        "@vercel/analytics": "^2.0.1",
        "@xyflow/react": "^12.12.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "date-fns": "^4.4.0",
        "dotenv": "^18.0.5",
        "html-to-image": "^1.11.13",
        "lucide-react": "^1.49.0",
        "minidenticons": "^4.2.1",
        "motion": "^13.5.0",
        "nuqs": "^2.10.1",
        "prom-client": "^15.1.3",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-joyride": "^3.2.0",
        "react-shiki": "^0.11.1",
        "react-transition-group": "^4.4.5",
        "recharts": "^3.10.1",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "semver": "^7.8.5",
        "shiki": "^4.5.0",
        "smol-toml": "^1.9.0",
        "string-to-color": "^2.2.2",
        "surrealdb": "^2.0.9",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tanstack/router-plugin": "^1.168.42",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-transition-group": "^4.4.12",
        "@types/semver": "^7.8.0",
        "@mdx-js/rollup": "^3.1.1",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "happy-dom": "^20.14.5",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.2",
        "vitest": "^5.0.3",
        "@testing-library/dom": "^10.4.2"
    }
}
